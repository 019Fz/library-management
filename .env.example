# Copy this file to .env and replace the placeholder values. Never commit .env.

# Postgres (used by docker compose)
POSTGRES_USER=library_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=library_db
POSTGRES_PORT=your_port

# Backend
PORT=your_port
CORS_ORIGIN=http://localhost:your_port
DATABASE_URL="postgresql://library_user:change_me@localhost:your_port/library_db?schema=public"

# Admin account created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# JWT (use a long random string, e.g. "openssl rand -hex 48")
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Password for the demo users created by the seed script
DEMO_USER_PASSWORD=change_me

# Optional LLM translator for the AI Query Agent. Disabled unless BOTH
# AI_LLM_BASE_URL and AI_LLM_MODEL are set. Any OpenAI-compatible API works
# (OpenAI, or a local Ollama). Add AI_LLM_API_KEY here only if your provider needs one.
AI_LLM_BASE_URL=http://host.docker.internal:11434/v1
AI_LLM_MODEL=your-model-name
AI_LLM_TIMEOUT_MS=60000

# Frontend (Vite)
VITE_API_URL=http://localhost:your_port
