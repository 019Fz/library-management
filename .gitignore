# The one .gitignore of the project (backend and frontend are covered from here).

# Dependencies
node_modules/

# Environment files (never commit secrets). .env.example is allowed: placeholders only
.env
.env.*
!.env.example

# Build output
dist/
build/

# Generated Prisma client (created by "prisma generate" and inside the Docker build)
backend/src/generated/

# Logs
logs/
*.log
npm-debug.log*

# Local-only files
*.local

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sw?
